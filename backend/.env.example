APP_ENV=development
APP_NAME=Sparestracker Marketing Agent
OWNER_EMAIL=you@example.com
SESSION_SIGNING_KEY=replace-with-a-long-random-value
TOKEN_ENCRYPTION_KEY=generate-with-fernet-key-command
